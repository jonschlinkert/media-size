{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ]
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "*.ts",
    "src",
    "support",
    "test"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tmp"
  ]
}
